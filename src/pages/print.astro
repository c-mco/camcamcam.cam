---
import { resume } from '../data/resume';
import '../styles/global.css';

const { personal, highlights, leadershipExperience, previousExperience, professionalDevelopment } = resume;
const aesopRole = leadershipExperience.find((r) => r.company.includes('Aesop'))!;
const stargateRole = leadershipExperience.find((r) => r.company.includes('Stargate'))!;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{personal.name} - Resume</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..900;1,9..144,400..900&family=JetBrains+Mono:wght@400;500;600;700&family=Outfit:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <style>
      @page {
        size: A4 portrait;
        margin: 7mm 11mm 7mm 11mm;
      }
      @media print {
        html,
        body {
          background-color: #ffffff !important;
          -webkit-print-color-adjust: exact !important;
          print-color-adjust: exact !important;
        }
      }
      body {
        background-color: #ffffff;
        color: #1a110b;
        font-family: 'Outfit', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }
      .page-break {
        break-before: page;
        page-break-before: always;
      }
      .page-container {
        box-sizing: border-box;
        height: 281mm;
        max-height: 281mm;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        overflow: hidden;
      }
    </style>
  </head>
  <body class="bg-white text-espresso-950 max-w-[210mm] mx-auto p-0">
    <!-- ================= PAGE 1 ================= -->
    <div class="page-container">
      <div class="space-y-3.5">
        <!-- Header -->
        <header class="border-b-2 border-mustard-500 pb-3">
          <div class="flex items-start justify-between">
            <div>
              <h1 class="text-[27pt] font-serif font-black text-espresso-950 tracking-normal leading-none">
                {personal.name}
              </h1>
              <p class="text-[11.5pt] font-serif italic font-bold text-mustard-600 mt-1">
                {personal.title}
              </p>
            </div>
            <!-- Quick Pill Badge -->
            <div class="text-right pt-0.5">
              <span class="inline-block text-[7.5pt] font-mono font-bold uppercase tracking-wider text-espresso-800 bg-cream-200 border border-cream-300 px-3 py-1 rounded-full shadow-sm">
                {personal.location} • {personal.citizenship}
              </span>
            </div>
          </div>

          <!-- Contact Details Bar -->
          <div class="text-[8.2pt] text-espresso-700 mt-2.5 flex flex-wrap items-center gap-x-3 font-medium">
            <span>{personal.phone}</span>
            <span class="text-mustard-500 font-bold">•</span>
            <a href={`mailto:${personal.email}`} class="text-espresso-900 font-semibold underline underline-offset-2">
              {personal.email}
            </a>
            <span class="text-mustard-500 font-bold">•</span>
            <a href={personal.website} class="text-espresso-900 font-semibold underline underline-offset-2">
              {personal.website.replace('https://', '')}
            </a>
          </div>
        </header>

        <!-- Highlights Stat Cards -->
        <section class="grid grid-cols-4 gap-2.5">
          {highlights.map((h) => (
            <div class="bg-cream-100/80 border border-cream-300 rounded-xl px-3 py-2 flex flex-col justify-between min-h-[50px]">
              <span class="font-serif font-black text-mustard-600 text-[12pt] leading-tight">
                {h.metric}
              </span>
              <span class="font-mono text-[6.8pt] font-semibold text-espresso-700 leading-tight uppercase tracking-wider mt-0.5">
                {h.label}
              </span>
            </div>
          ))}
        </section>

        <!-- Executive Summary -->
        <section>
          <div class="flex items-center gap-2 border-b border-cream-300 pb-1 mb-1.5">
            <span class="w-2.5 h-2.5 rounded-full bg-mustard-500"></span>
            <h2 class="text-[9.5pt] font-serif font-black text-espresso-950 uppercase tracking-widest">
              Executive Summary
            </h2>
          </div>
          <p class="text-[8.3pt] text-espresso-900 leading-[1.42]">
            {personal.summary}
          </p>
        </section>

        <!-- Employment History (Aesop) -->
        <section class="space-y-2.5">
          <div class="flex items-center gap-2 border-b border-cream-300 pb-1">
            <span class="w-2.5 h-2.5 rounded-full bg-mustard-500"></span>
            <h2 class="text-[9.5pt] font-serif font-black text-espresso-950 uppercase tracking-widest">
              Employment History
            </h2>
          </div>

          <article>
            <div class="flex items-baseline justify-between mb-2">
              <div>
                <h3 class="text-[10pt] font-bold text-espresso-950 inline">
                  {aesopRole.role}
                </h3>
                <span class="text-[9pt] font-medium text-espresso-700">
                  {' '}— {aesopRole.company} ({aesopRole.industry})
                </span>
              </div>
              <span class="text-[7.5pt] font-bold font-mono text-espresso-800 bg-cream-200 border border-cream-300 px-2.5 py-0.5 rounded-full shrink-0 ml-2">
                {aesopRole.period}
              </span>
            </div>

            <!-- Achievements -->
            <div class="space-y-2">
              {aesopRole.achievements.map((ach) => (
                <div class="text-[8.2pt] leading-[1.38] pl-2.5 border-l-2 border-mustard-400">
                  <span class="font-bold text-espresso-950">{ach.title}: </span>
                  <span class="text-espresso-900">{ach.description}</span>
                  {ach.tags && ach.tags.length > 0 && (
                    <div class="flex flex-wrap gap-1 mt-1">
                      {ach.tags.map((tag) => (
                        <span class="text-[6.6pt] font-mono font-medium text-espresso-700 bg-cream-100 border border-cream-300 px-1.5 py-0.2 rounded">
                          {tag}
                        </span>
                      ))}
                    </div>
                  )}
                </div>
              ))}
            </div>
          </article>
        </section>
      </div>

      <!-- Page 1 Footer -->
      <footer class="text-[7.2pt] text-espresso-500 font-mono flex justify-between border-t border-cream-300 pt-2 pb-0.5">
        <span>{personal.name.toUpperCase()} • {personal.title.toUpperCase()}</span>
        <span>PAGE 1 OF 2</span>
      </footer>
    </div>

    <!-- ================= PAGE BREAK ================= -->
    <div class="page-break"></div>

    <!-- ================= PAGE 2 ================= -->
    <div class="page-container">
      <div class="space-y-3.5">
        <!-- Employment History Continued (Stargate Tech) -->
        <section class="space-y-2.5">
          <div class="flex items-center gap-2 border-b border-cream-300 pb-1">
            <span class="w-2.5 h-2.5 rounded-full bg-mustard-500"></span>
            <h2 class="text-[9.5pt] font-serif font-black text-espresso-950 uppercase tracking-widest">
              Employment History (Continued)
            </h2>
          </div>

          <article>
            <div class="flex items-baseline justify-between mb-2">
              <div>
                <h3 class="text-[10pt] font-bold text-espresso-950 inline">
                  {stargateRole.role}
                </h3>
                <span class="text-[9pt] font-medium text-espresso-700">
                  {' '}— {stargateRole.company} ({stargateRole.industry})
                </span>
              </div>
              <span class="text-[7.5pt] font-bold font-mono text-espresso-800 bg-cream-200 border border-cream-300 px-2.5 py-0.5 rounded-full shrink-0 ml-2">
                {stargateRole.period}
              </span>
            </div>

            <!-- Achievements -->
            <div class="space-y-2">
              {stargateRole.achievements.map((ach) => (
                <div class="text-[8.2pt] leading-[1.38] pl-2.5 border-l-2 border-mustard-400">
                  <span class="font-bold text-espresso-950">{ach.title}: </span>
                  <span class="text-espresso-900">{ach.description}</span>
                  {ach.tags && ach.tags.length > 0 && (
                    <div class="flex flex-wrap gap-1 mt-1">
                      {ach.tags.map((tag) => (
                        <span class="text-[6.6pt] font-mono font-medium text-espresso-700 bg-cream-100 border border-cream-300 px-1.5 py-0.2 rounded">
                          {tag}
                        </span>
                      ))}
                    </div>
                  )}
                </div>
              ))}
            </div>
          </article>
        </section>

        <!-- Previous Experience -->
        <section>
          <div class="flex items-center gap-2 border-b border-cream-300 pb-1 mb-2">
            <span class="w-2.5 h-2.5 rounded-full bg-rust-500"></span>
            <h2 class="text-[9.5pt] font-serif font-black text-espresso-950 uppercase tracking-widest">
              Previous Experience ({previousExperience.period})
            </h2>
          </div>
          <div class="grid grid-cols-2 gap-2.5">
            {previousExperience.roles.map((prev) => (
              <div class="bg-cream-50/90 border border-cream-300 rounded-xl p-2.5 text-[8.1pt] leading-snug">
                <div class="font-bold text-espresso-950">
                  {prev.role} <span class="text-espresso-600 font-normal">| {prev.company}{prev.location ? ` (${prev.location})` : ''}</span>
                </div>
                <div class="text-espresso-800 text-[7.8pt] mt-1">
                  {prev.description}
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- Professional Development & Certifications -->
        <section class="space-y-2.5">
          <div class="flex items-center gap-2 border-b border-cream-300 pb-1">
            <span class="w-2.5 h-2.5 rounded-full bg-avocado-500"></span>
            <h2 class="text-[9.5pt] font-serif font-black text-espresso-950 uppercase tracking-widest">
              Professional Development & Certifications
            </h2>
          </div>

          <div class="space-y-2.5">
            <!-- Certifications -->
            <div class="bg-cream-50/90 border border-cream-300 rounded-xl p-2.5">
              <span class="font-bold text-espresso-950 text-[8.3pt] block mb-1.5">
                ISTQB Certifications:
              </span>
              <div class="flex flex-wrap gap-2">
                {professionalDevelopment.istqbCertifications.map((cert) => (
                  <span class="inline-flex items-center text-[7.6pt] font-mono bg-cream-100 text-espresso-900 border border-cream-300 px-2.5 py-1 rounded-lg">
                    <span class="font-bold text-mustard-700 mr-1.5">✓</span>
                    <span>{cert.title} ({cert.year}) — {cert.issuer}</span>
                  </span>
                ))}
              </div>
            </div>

            <!-- Technical Skills -->
            <div class="bg-cream-50/90 border border-cream-300 rounded-xl p-2.5">
              <span class="font-bold text-espresso-950 text-[8.3pt] block mb-1.5">
                Technical Skill Expansion:
              </span>
              <div class="flex flex-wrap gap-1.5">
                {professionalDevelopment.technicalSkills.map((skill) => (
                  <span class="text-[7.4pt] font-mono font-medium text-espresso-900 bg-cream-100 border border-cream-300 px-2.5 py-0.5 rounded-full">
                    {skill}
                  </span>
                ))}
              </div>
            </div>
          </div>
        </section>
      </div>

      <!-- Page 2 Footer -->
      <footer class="text-[7.2pt] text-espresso-500 font-mono flex justify-between border-t border-cream-300 pt-2 pb-0.5">
        <span>{personal.name.toUpperCase()} • {personal.website.replace('https://', '').toUpperCase()}</span>
        <span>PAGE 2 OF 2</span>
      </footer>
    </div>
  </body>
</html>
