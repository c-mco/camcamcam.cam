---
import { resume } from '../data/resume';
import '../styles/global.css';

const { personal, leadershipExperience, previousExperience, professionalDevelopment } = resume;
const aesopRole = leadershipExperience.find(r => r.company.includes('Aesop'))!;
const stargateRole = leadershipExperience.find(r => r.company.includes('Stargate'))!;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{personal.name} - Resume</title>
    <style>
      @page {
        size: A4 portrait;
        margin: 12mm 15mm 12mm 15mm;
      }
      body {
        background: #ffffff;
        color: #241710;
        font-family: 'Outfit', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        font-size: 8.8pt;
        line-height: 1.35;
      }
      .page-break {
        page-break-before: always;
        break-before: page;
      }
      .avoid-break {
        break-inside: avoid;
        page-break-inside: avoid;
      }
    </style>
  </head>
  <body class="bg-white text-espresso-950 max-w-[210mm] mx-auto p-0">
    <!-- PAGE 1 -->
    <div class="min-h-[268mm] flex flex-col justify-between">
      <div>
        <!-- Name Header with 70s Flair -->
        <header class="border-b-2 border-[#D99B26] pb-2.5 mb-3.5">
          <h1 class="text-3xl font-serif font-black text-espresso-950 tracking-tight">{personal.name}</h1>
          <p class="text-[10pt] font-serif italic font-bold text-mustard-600 mt-0.5">{personal.title}</p>

          <p class="text-[8.5pt] text-espresso-600 mt-1.5 flex flex-wrap items-center gap-x-2 font-medium">
            <span>{personal.location}</span>
            <span>•</span>
            <span>{personal.citizenship}</span>
            <span>•</span>
            <span>{personal.phone}</span>
            <span>•</span>
            <a href={`mailto:${personal.email}`} class="text-espresso-900 font-bold underline underline-offset-2">{personal.email}</a>
            <span>•</span>
            <a href={personal.website} class="text-espresso-900 font-bold underline underline-offset-2">{personal.website.replace('https://', '')}</a>
          </p>
        </header>

        <!-- Summary -->
        <section class="mb-4">
          <h2 class="text-[10.5pt] font-serif font-black text-espresso-950 uppercase tracking-wider border-b border-cream-300 pb-0.5 mb-1.5 flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-mustard-500 inline-block"></span>
            <span>Summary</span>
          </h2>
          <p class="text-[8.8pt] text-espresso-900 leading-relaxed text-justify">
            {personal.summary}
          </p>
        </section>

        <!-- Employment History (Aesop) -->
        <section>
          <h2 class="text-[10.5pt] font-serif font-black text-espresso-950 uppercase tracking-wider border-b border-cream-300 pb-0.5 mb-2.5 flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-mustard-500 inline-block"></span>
            <span>Employment History</span>
          </h2>

          <!-- Aesop Role -->
          <article class="avoid-break">
            <div class="flex items-baseline justify-between mb-0.5">
              <h3 class="text-[10pt] font-bold text-espresso-950">
                {aesopRole.role} <span class="font-normal text-espresso-600">— {aesopRole.company} ({aesopRole.industry})</span>
              </h3>
              <span class="text-[8pt] font-bold font-mono text-espresso-600 bg-cream-200 px-2 py-0.5 rounded-full">{aesopRole.period}</span>
            </div>

            <div class="space-y-2 mt-2">
              {aesopRole.achievements.map((ach) => (
                <div class="text-[8.5pt] text-espresso-900 leading-snug">
                  <span class="font-bold text-espresso-950">• {ach.title}: </span>
                  <span>{ach.description}</span>
                </div>
              ))}
            </div>
          </article>
        </section>
      </div>

      <!-- Footer for Page 1 -->
      <div class="text-[7.5pt] text-espresso-400 font-mono flex justify-between border-t border-cream-200 pt-2 pb-1 mt-4">
        <span>{personal.name} • Resume</span>
        <span>Page 1 of 2</span>
      </div>
    </div>

    <!-- PAGE BREAK -->
    <div class="page-break"></div>

    <!-- PAGE 2 -->
    <div class="min-h-[268mm] flex flex-col justify-between pt-2">
      <div>
        <!-- Stargate Tech Role -->
        <section class="mb-5">
          <article class="avoid-break">
            <div class="flex items-baseline justify-between mb-0.5">
              <h3 class="text-[10pt] font-bold text-espresso-950">
                {stargateRole.role} <span class="font-normal text-espresso-600">— {stargateRole.company} ({stargateRole.industry})</span>
              </h3>
              <span class="text-[8pt] font-bold font-mono text-espresso-600 bg-cream-200 px-2 py-0.5 rounded-full">{stargateRole.period}</span>
            </div>

            <div class="space-y-2 mt-2">
              {stargateRole.achievements.map((ach) => (
                <div class="text-[8.5pt] text-espresso-900 leading-snug">
                  <span class="font-bold text-espresso-950">• {ach.title}: </span>
                  <span>{ach.description}</span>
                </div>
              ))}
            </div>
          </article>
        </section>

        <!-- Previous Experience -->
        <section class="mb-5 avoid-break">
          <h2 class="text-[10.5pt] font-serif font-black text-espresso-950 uppercase tracking-wider border-b border-cream-300 pb-0.5 mb-2 flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-rust-500 inline-block"></span>
            <span>Previous Experience ({previousExperience.period})</span>
          </h2>
          <div class="space-y-1.5">
            {previousExperience.roles.map((prev) => (
              <div class="text-[8.5pt] text-espresso-900 leading-snug">
                <span class="font-bold text-espresso-950">• {prev.role} | {prev.company}{prev.location ? ` (${prev.location})` : ''}: </span>
                <span>{prev.description}</span>
              </div>
            ))}
          </div>
        </section>

        <!-- Professional Development & Certifications -->
        <section class="avoid-break">
          <h2 class="text-[10.5pt] font-serif font-black text-espresso-950 uppercase tracking-wider border-b border-cream-300 pb-0.5 mb-2 flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-avocado-500 inline-block"></span>
            <span>Professional Development & Certifications</span>
          </h2>

          <div class="space-y-1.5 text-[8.5pt] text-espresso-900">
            <div>
              <span class="font-bold text-espresso-950">ISTQB Certifications: </span>
              <span>
                {professionalDevelopment.istqbCertifications.map(c => `${c.title} (${c.year}) – ${c.issuer}`).join(' • ')}
              </span>
            </div>

            <div>
              <span class="font-bold text-espresso-950">Technical Skill Expansion: </span>
              <span>
                {professionalDevelopment.technicalSkills.join(', ')}.
              </span>
            </div>
          </div>
        </section>
      </div>

      <!-- Footer for Page 2 -->
      <div class="text-[7.5pt] text-espresso-400 font-mono flex justify-between border-t border-cream-200 pt-2 pb-1 mt-4">
        <span>{personal.name} • {personal.website.replace('https://', '')}</span>
        <span>Page 2 of 2</span>
      </div>
    </div>
  </body>
</html>
