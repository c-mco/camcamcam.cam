---
import Layout from '../layouts/Layout.astro';
import Bend from '../components/Bend.astro';
import SectionHead from '../components/SectionHead.astro';
import Sunrise from '../components/Sunrise.astro';
import { resume } from '../data/resume';
import { Mail, Phone, Globe, MapPin, Download, FileText, Printer } from '@lucide/astro';

const { personal, highlights, leadershipExperience, previousExperience, professionalDevelopment } = resume;

const [firstName, ...rest] = personal.name.split(' ');
const lastName = rest.join(' ');

// Fill colour + matching text colour for each stripe swatch
const swatches = [
  { bg: 'bg-[var(--s1)]', fg: 'text-[#24140A]' },
  { bg: 'bg-[var(--s2)]', fg: 'text-[#24140A]' },
  { bg: 'bg-[var(--s3)]', fg: 'text-[#24140A]' },
  { bg: 'bg-[var(--s4)]', fg: 'text-[#FFF6E5]' },
];
const sw = (i: number) => swatches[i % swatches.length];
const pad = (n: number) => String(n).padStart(2, '0');
---

<Layout>
  <!-- ─── HERO: stripes run in from the left and bend up the right wall ─── -->
  <section class="relative overflow-hidden border-b-[3px] border-ink" aria-labelledby="hero-name">
    <Bend w={14} r={44} mR={14} class="absolute right-0 bottom-0 sm:hidden" />
    <Bend w={22} r={80} mR={32} class="absolute right-0 bottom-0 hidden sm:block lg:hidden" />
    <Bend w={34} r={130} mR={56} class="absolute right-0 bottom-0 hidden lg:block" />

    <div class="wrap relative pt-12 sm:pt-16 lg:pt-20 pb-[150px] sm:pb-[240px] lg:pb-[260px]">
      <div class="pr-24 sm:pr-48 lg:pr-0 lg:max-w-[62%]">
        <p class="inline-flex flex-wrap items-center gap-x-2 font-mono text-[11px] sm:text-xs font-bold uppercase tracking-[0.2em] text-ink-muted">
          <MapPin class="w-3.5 h-3.5" stroke-width={2.5} aria-hidden="true" />
          {personal.location}<span aria-hidden="true">·</span>{personal.citizenship}
        </p>

        <h1 id="hero-name" class="font-display tracking-tight leading-[0.82] mt-5 text-[clamp(3.6rem,15vw,10rem)]">
          <span class="block">{firstName}</span>
          <span class="block">{lastName}</span>
        </h1>

        <p class="inline-block mt-6 sm:mt-8 px-5 py-2 rounded-full bg-[var(--s4)] text-[#FFF6E5] font-display text-xl sm:text-3xl tracking-tight">
          {personal.title}
        </p>

        <ul class="mt-8 flex flex-col sm:flex-row sm:flex-wrap gap-x-6 gap-y-3 text-sm sm:text-base font-semibold">
          <li>
            <a href={`mailto:${personal.email}`} class="inline-flex items-center gap-2 underline decoration-[3px] underline-offset-4 decoration-[var(--s2)] hover:decoration-[var(--s4)] break-all">
              <Mail class="w-4 h-4 shrink-0" stroke-width={2.5} aria-hidden="true" />{personal.email}
            </a>
          </li>
          <li>
            <a href={`tel:${personal.phone.replace(/\s+/g, '')}`} class="inline-flex items-center gap-2 underline decoration-[3px] underline-offset-4 decoration-[var(--s2)] hover:decoration-[var(--s4)]">
              <Phone class="w-4 h-4 shrink-0" stroke-width={2.5} aria-hidden="true" />{personal.phone}
            </a>
          </li>
          <li>
            <a href={personal.website} class="inline-flex items-center gap-2 underline decoration-[3px] underline-offset-4 decoration-[var(--s2)] hover:decoration-[var(--s4)]">
              <Globe class="w-4 h-4 shrink-0" stroke-width={2.5} aria-hidden="true" />{personal.website.replace('https://', '')}
            </a>
          </li>
        </ul>

        <div class="mt-9 flex flex-wrap items-center gap-3 sm:gap-4">
          <a href="/resume.pdf" download="Cam McOrist - Resume.pdf" class="btn bg-[#24140A] text-[var(--s1)] dark:bg-[var(--s1)] dark:text-[#24140A]">
            <Download class="w-4 h-4" stroke-width={2.75} aria-hidden="true" /> Resume PDF
          </a>
          <a href="/resume.docx" download="Cam McOrist - Resume.docx" class="btn bg-card">
            <FileText class="w-4 h-4" stroke-width={2.75} aria-hidden="true" /> Word
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── METRICS: four arches ─── -->
  <section class="bg-[#24140A] dark:bg-[#120B06] text-[#FBEFD9]" aria-label="Highlights">
    <div class="wrap pt-14 sm:pt-20">
      <ul class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-5 items-end">
        {highlights.map((item, i) => (
          <li class={`${sw(i).bg} ${sw(i).fg} rounded-t-full px-4 sm:px-6 pt-[42%] pb-6 sm:pb-8 text-center flex flex-col items-center justify-end ${i % 2 ? 'lg:min-h-[19rem]' : 'lg:min-h-[22rem]'}`}>
            <span class="font-display leading-[0.9] tracking-tight text-[clamp(2.1rem,6.5vw,3.75rem)]">{item.metric}</span>
            <span class="mt-3 text-xs sm:text-sm font-bold leading-snug max-w-[14ch]">{item.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ─── 01 SUMMARY ─── -->
  <section class="py-20 sm:py-28" aria-labelledby="summary-h">
    <div class="wrap">
      <SectionHead num="01" title="Summary" kicker="Leadership · Quality culture" id="summary-h" />
      <div class="grid lg:grid-cols-[1fr_minmax(0,46rem)] gap-8">
        <div class="hidden lg:block stripes-v rounded-t-full w-[150px] h-full min-h-[14rem] justify-self-start" aria-hidden="true"></div>
        <p class="font-display font-medium text-[clamp(1.3rem,2.6vw,1.9rem)] leading-[1.35] tracking-tight" style="font-weight: 500;">
          {personal.summary}
        </p>
      </div>
    </div>
  </section>

  <!-- ─── 02 EXPERIENCE ─── -->
  <section class="pb-20 sm:pb-28" aria-labelledby="exp-h">
    <div class="wrap">
      <SectionHead num="02" title="Employment History" kicker="Engineering leadership" id="exp-h" />
      <p class="max-w-2xl text-base sm:text-lg font-medium text-ink-muted -mt-4 mb-14">
        Architecting testing frameworks, CI/CD governance, AI-assisted migration, and inclusive engineering culture across enterprise retail and fintech.
      </p>

      <div class="space-y-20 sm:space-y-28">
        {leadershipExperience.map((job) => (
          <article aria-label={`${job.role}, ${job.company}`}>
            <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
              <div>
                <h3 class="font-display text-[clamp(2rem,5vw,3.5rem)] leading-[0.95] tracking-tight">{job.company}</h3>
                <p class="mt-2 text-lg sm:text-xl font-bold">
                  {job.role}
                  <span class="text-ink-muted font-semibold"> · {job.industry}</span>
                </p>
              </div>
              <div class="flex flex-wrap items-center gap-2 font-mono text-xs sm:text-sm font-bold">
                <span class="px-3.5 py-1.5 rounded-full bg-[#24140A] text-[var(--s1)] dark:bg-[var(--s1)] dark:text-[#24140A]">{job.period}</span>
                <span class="px-3.5 py-1.5 rounded-full border-[3px] border-ink">{job.location}</span>
              </div>
            </div>

            <!-- racing stripe: bleeds off the left edge, rounds off on the right -->
            <div
              class="stripes-h h-8 sm:h-10 mt-6 mb-10 rounded-r-full ml-[calc((100%_-_100vw)/2)] w-[calc(100%_+_(100vw_-_100%)/2)]"
              aria-hidden="true"
            ></div>

            <ol class="grid md:grid-cols-2 gap-x-10 gap-y-10">
              {job.achievements.map((ach, i) => (
                <li class="flex gap-4">
                  <span class={`${sw(i).bg} ${sw(i).fg} shrink-0 w-12 h-12 rounded-full flex items-center justify-center font-display text-lg border-[3px] border-ink`} aria-hidden="true">
                    {pad(i + 1)}
                  </span>
                  <div class="min-w-0">
                    <h4 class="text-lg font-extrabold leading-tight">{ach.title}</h4>
                    <p class="mt-2 text-[15px] leading-relaxed text-ink-muted">{ach.description}</p>
                    <ul class="mt-3 flex flex-wrap gap-1.5" aria-label="Tools and topics">
                      {ach.tags.map((tag) => (
                        <li class="px-2.5 py-0.5 rounded-full border-2 border-ink text-[11px] font-mono font-bold">{tag}</li>
                      ))}
                    </ul>
                  </div>
                </li>
              ))}
            </ol>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── 03 PRIOR EXPERIENCE ─── -->
  <section class="py-20 sm:py-28 bg-card border-y-[3px] border-ink" aria-labelledby="prior-h">
    <div class="wrap">
      <SectionHead num="03" title="Previous Experience" kicker={previousExperience.period} id="prior-h" />
      <p class="max-w-2xl text-base sm:text-lg font-medium text-ink-muted -mt-4 mb-12">
        Core testing fundamentals: hardware/software validation, UAT coordination, national sports technology workflows, and banking POS integrations.
      </p>

      <ul class="grid sm:grid-cols-2 gap-6">
        {previousExperience.roles.map((prev, i) => (
          <li class="rounded-[2rem] border-[3px] border-ink overflow-hidden bg-canvas flex flex-col">
            <div class={`${sw(i).bg} ${sw(i).fg} px-6 pt-6 pb-5 rounded-br-[3rem]`}>
              <h3 class="font-display text-2xl sm:text-3xl leading-none tracking-tight">{prev.company}</h3>
              <p class="mt-2 font-mono text-xs font-bold uppercase tracking-wider">
                {prev.role}{prev.location && <span> · {prev.location}</span>}
              </p>
            </div>
            <p class="px-6 py-5 text-[15px] leading-relaxed text-ink-muted">{prev.description}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ─── 04 QUALIFICATIONS ─── -->
  <section class="py-20 sm:py-28" aria-labelledby="qual-h">
    <div class="wrap">
      <SectionHead num="04" title="Professional Development" kicker="Certifications & learning" id="qual-h" />

      <div class="grid lg:grid-cols-2 gap-14 lg:gap-16">
        <div>
          <h3 class="font-mono text-xs font-bold uppercase tracking-[0.2em] text-ink-muted mb-6">ISTQB Certifications</h3>
          <ul class="space-y-6">
            {professionalDevelopment.istqbCertifications.map((cert, i) => (
              <li class="flex items-center gap-5">
                <span class="relative shrink-0 w-24 h-24 rounded-full flex items-center justify-center" aria-hidden="true">
                  <span class="absolute inset-0 rounded-full bg-[var(--s4)]"></span>
                  <span class="absolute inset-[10px] rounded-full bg-[var(--s3)]"></span>
                  <span class={`absolute inset-[20px] rounded-full ${i ? 'bg-[var(--s2)]' : 'bg-[var(--s1)]'}`}></span>
                  <span class="relative font-display text-lg text-[#24140A]">{cert.year}</span>
                </span>
                <div>
                  <p class="text-lg font-extrabold leading-tight">{cert.title}</p>
                  <p class="mt-1 font-mono text-xs font-bold text-ink-muted">{cert.year} · {cert.issuer}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>

        <div>
          <h3 class="font-mono text-xs font-bold uppercase tracking-[0.2em] text-ink-muted mb-6">Technical Skill Expansion</h3>
          <ul class="flex flex-wrap gap-2.5">
            {professionalDevelopment.technicalSkills.map((skill, i) => (
              <li class={`${sw(i).bg} ${sw(i).fg} px-4 py-2 rounded-full border-[3px] border-ink text-sm font-extrabold`}>{skill}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── SUNRISE DOWNLOAD BANNER ─── -->
  <section class="bg-[#24140A] dark:bg-[#120B06] text-[#FBEFD9] pt-16 sm:pt-20 overflow-hidden [--s5:#8A4826]" aria-labelledby="dl-h">
    <div class="wrap text-center">
      <h2 id="dl-h" class="font-display text-[clamp(2.25rem,7vw,4.5rem)] leading-[0.95] tracking-tight">Take it with you</h2>
      <p class="mt-3 text-base sm:text-lg text-[#E8CFB2]">The same resume, kept in sync — as PDF, Word, or a clean print view.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3 sm:gap-4 [--border-color:#FBEFD9]">
        <a href="/resume.pdf" download="Cam McOrist - Resume.pdf" class="btn bg-[var(--s1)] text-[#24140A]">
          <Download class="w-4 h-4" stroke-width={2.75} aria-hidden="true" /> PDF
        </a>
        <a href="/resume.docx" download="Cam McOrist - Resume.docx" class="btn bg-[#24140A] text-[#FBEFD9]">
          <FileText class="w-4 h-4" stroke-width={2.75} aria-hidden="true" /> Word
        </a>
        <a href="/print" target="_blank" class="btn bg-[#24140A] text-[#FBEFD9]">
          <Printer class="w-4 h-4" stroke-width={2.75} aria-hidden="true" /> Print view
        </a>
      </div>
    </div>
    <Sunrise class="block w-full max-w-4xl mx-auto mt-12 sm:mt-16 -mb-px" />
  </section>
</Layout>
