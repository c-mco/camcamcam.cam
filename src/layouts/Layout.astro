---
import '../styles/global.css';
import { resume } from '../data/resume';
import { FileText, Download, Printer, Moon, Sun, ShieldCheck } from '@lucide/astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${resume.personal.name} — ${resume.personal.title}`,
  description = resume.personal.summary.slice(0, 160) + '...',
} = Astro.props;

const { personal } = resume;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph / Meta -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={personal.website} />

    <!-- Inline script to avoid theme flash -->
    <script is:inline>
      const savedTheme = localStorage.getItem('theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      if (savedTheme === 'dark' || (!savedTheme && prefersDark)) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  <body class="bg-parchment-100 dark:bg-[#121315] text-ink-900 dark:text-[#ECE8E1] transition-colors duration-200 min-h-screen flex flex-col antialiased">
    <!-- Accessible Skip to Content -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-ink-900 focus:text-white dark:focus:bg-white dark:focus:text-ink-900 rounded-md shadow-lg outline-none ring-2 ring-aesop-amber"
    >
      Skip to content
    </a>

    <!-- Sticky Editorial Navigation Header -->
    <header class="sticky top-0 z-40 w-full backdrop-blur-md bg-parchment-100/85 dark:bg-[#121315]/85 border-b border-parchment-300/80 dark:border-zinc-800 transition-colors">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
        <a href="/" class="group flex items-center gap-2.5 outline-none">
          <span class="w-8 h-8 rounded bg-ink-900 dark:bg-zinc-100 text-parchment-100 dark:text-ink-900 flex items-center justify-center font-serif font-bold text-sm tracking-tight group-hover:scale-105 transition-transform">
            CM
          </span>
          <span class="font-serif font-semibold text-lg tracking-tight group-hover:text-aesop-amber dark:group-hover:text-amber-400 transition-colors">
            {personal.name}
          </span>
        </a>

        <!-- Navigation actions -->
        <div class="flex items-center gap-2 sm:gap-3">
          <!-- Download PDF -->
          <a
            href="/resume.pdf"
            download="Cam McOrist - Resume.pdf"
            title="Download PDF version of resume"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs sm:text-sm font-medium rounded-full bg-ink-900 text-parchment-100 dark:bg-zinc-100 dark:text-zinc-950 hover:bg-aesop-amber dark:hover:bg-amber-400 hover:text-white dark:hover:text-ink-900 shadow-sm transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-aesop-amber"
          >
            <Download class="w-3.5 h-3.5" />
            <span>PDF</span>
          </a>

          <!-- Download Word -->
          <a
            href="/resume.docx"
            download="Cam McOrist - Resume.docx"
            title="Download Microsoft Word .docx version of resume"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs sm:text-sm font-medium rounded-full border border-zinc-300 dark:border-zinc-700 hover:border-zinc-500 text-zinc-700 dark:text-zinc-200 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-aesop-amber"
          >
            <FileText class="w-3.5 h-3.5 text-blue-600 dark:text-blue-400" />
            <span class="hidden xs:inline">Word</span>
            <span class="xs:hidden">DOCX</span>
          </a>

          <!-- Print Direct Link -->
          <a
            href="/print"
            target="_blank"
            title="Open print-optimized view"
            class="hidden md:inline-flex items-center gap-1.5 px-2.5 py-1.5 text-xs font-medium text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white transition-colors"
          >
            <Printer class="w-3.5 h-3.5" />
            <span>Print View</span>
          </a>

          <div class="w-px h-5 bg-zinc-300 dark:bg-zinc-800 mx-1 hidden sm:block"></div>

          <!-- Theme Toggle -->
          <button
            id="theme-toggle"
            type="button"
            aria-label="Toggle visual theme (dark or light mode)"
            class="p-2 rounded-full text-zinc-600 dark:text-zinc-300 hover:bg-zinc-200/60 dark:hover:bg-zinc-800 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-aesop-amber"
          >
            <Sun class="w-4 h-4 hidden dark:block" />
            <Moon class="w-4 h-4 block dark:hidden" />
          </button>
        </div>
      </div>
    </header>

    <!-- Main Content Container -->
    <main id="main-content" class="flex-grow max-w-5xl w-full mx-auto px-4 sm:px-6 py-8 sm:py-12">
      <slot />
    </main>

    <!-- Colophon & Footer -->
    <footer class="border-t border-parchment-300 dark:border-zinc-800 mt-16 bg-parchment-200/60 dark:bg-[#0d0e10]/80 py-12 transition-colors">
      <div class="max-w-5xl mx-auto px-4 sm:px-6">
        <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
          <div class="space-y-1">
            <p class="font-serif font-semibold text-zinc-900 dark:text-zinc-100">
              {personal.name}
            </p>
            <p class="text-xs text-zinc-500 dark:text-zinc-400 flex items-center gap-2">
              <ShieldCheck class="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400" />
              <span>Single Source of Truth: Web, PDF, and DOCX generated from <code class="font-mono text-[11px] bg-zinc-200 dark:bg-zinc-800 px-1 py-0.5 rounded">resume.yaml</code></span>
            </p>
          </div>

          <div class="flex items-center gap-4 text-xs font-medium text-zinc-600 dark:text-zinc-400">
            <a href="/resume.pdf" class="hover:text-aesop-amber dark:hover:text-amber-400 transition-colors underline underline-offset-2">Download PDF</a>
            <span>•</span>
            <a href="/resume.docx" class="hover:text-aesop-amber dark:hover:text-amber-400 transition-colors underline underline-offset-2">Download DOCX</a>
            <span>•</span>
            <a href="/print" target="_blank" class="hover:text-aesop-amber dark:hover:text-amber-400 transition-colors underline underline-offset-2">Print Page</a>
          </div>
        </div>

        <div class="mt-8 pt-6 border-t border-zinc-200/60 dark:border-zinc-800/60 flex flex-col sm:flex-row items-center justify-between text-xs text-zinc-400 dark:text-zinc-500 gap-2">
          <p>© {new Date().getFullYear()} {personal.name}. Built with Astro & Tailwind CSS.</p>
          <p class="font-mono">{personal.website.replace('https://', '')}</p>
        </div>
      </div>
    </footer>

    <!-- Client-side theme switch behavior -->
    <script>
      const toggle = document.getElementById('theme-toggle');
      toggle?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      });
    </script>
  </body>
</html>
