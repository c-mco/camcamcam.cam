---
import '../styles/global.css';
import { resume } from '../data/resume';
import { Download, FileText, Moon, Sun } from '@lucide/astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${resume.personal.name} — ${resume.personal.title}`,
  description = resume.personal.summary.slice(0, 160) + '...',
} = Astro.props;

const { personal } = resume;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F3C443" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={personal.website} />

    <script is:inline>
      try {
        const savedTheme = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (savedTheme === 'dark' || (!savedTheme && prefersDark)) {
          document.documentElement.classList.add('dark');
        }
      } catch (e) {}
    </script>
  </head>
  <body class="bg-canvas text-ink min-h-screen flex flex-col antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-5 focus:py-2.5 bg-card rounded-full font-bold border-[3px] border-ink"
    >
      Skip to content
    </a>

    <header class="sticky top-0 z-40 w-full bg-canvas border-b-[3px] border-ink">
      <div class="stripes-h h-4" aria-hidden="true"></div>
      <div class="wrap h-16 flex items-center justify-between gap-3">
        <a href="/" class="group flex items-center gap-3 min-w-0">
          <svg class="w-9 h-9 shrink-0 transition-transform duration-500 group-hover:rotate-180" viewBox="0 0 40 40" aria-hidden="true">
            <circle cx="20" cy="20" r="20" fill="var(--s4)" />
            <circle cx="20" cy="20" r="14" fill="var(--s3)" />
            <circle cx="20" cy="20" r="8" fill="var(--s1)" />
          </svg>
          <span class="font-display text-xl sm:text-2xl tracking-tight truncate">{personal.name}</span>
        </a>

        <nav class="flex items-center gap-2 sm:gap-3" aria-label="Resume downloads">
          <a
            href="/resume.pdf"
            download="Cam McOrist - Resume.pdf"
            class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full border-[3px] border-ink bg-[var(--s1)] text-[#24140A] text-sm font-extrabold hover:bg-[var(--s2)] transition-colors"
          >
            <Download class="w-4 h-4" stroke-width={2.75} />
            PDF
          </a>
          <a
            href="/resume.docx"
            download="Cam McOrist - Resume.docx"
            class="hidden sm:inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full border-[3px] border-ink bg-card text-sm font-extrabold hover:bg-[var(--s1)] hover:text-[#24140A] transition-colors"
          >
            <FileText class="w-4 h-4" stroke-width={2.75} />
            Word
          </a>
          <button
            id="theme-toggle"
            type="button"
            aria-label="Toggle dark mode"
            class="w-10 h-10 rounded-full border-[3px] border-ink bg-card flex items-center justify-center hover:bg-[var(--s1)] hover:text-[#24140A] transition-colors"
          >
            <Sun class="w-4 h-4 hidden dark:block" stroke-width={2.75} />
            <Moon class="w-4 h-4 block dark:hidden" stroke-width={2.75} />
          </button>
        </nav>
      </div>
    </header>

    <main id="main-content" class="flex-grow w-full">
      <slot />
    </main>

    <footer class="bg-[#24140A] text-[#FBEFD9] dark:bg-[#120B06]">
      <div class="wrap py-8 flex flex-col sm:flex-row items-center justify-between gap-3 text-sm">
        <p class="font-display text-lg">© {new Date().getFullYear()} {personal.name}</p>
        <div class="flex items-center gap-5 font-mono text-xs">
          <a href="/print" target="_blank" class="underline decoration-2 underline-offset-4 decoration-[var(--s2)] hover:text-[var(--s1)]">Print view</a>
          <span class="text-[var(--s1)]">{personal.website.replace('https://', '')}</span>
        </div>
      </div>
      <div class="stripes-h h-10" aria-hidden="true"></div>
    </footer>

    <script>
      const toggle = document.getElementById('theme-toggle');
      toggle?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        try { localStorage.setItem('theme', isDark ? 'dark' : 'light'); } catch (e) {}
      });
    </script>
  </body>
</html>
